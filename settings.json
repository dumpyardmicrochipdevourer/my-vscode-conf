{
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.mouseWheelScrollSensitivity": 3,
  "workbench.colorTheme": "Monokai",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.panel.showLabels": false,
  "workbench.editor.tabSizing": "shrink",
  "window.commandCenter": false,
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.padding.top": 12,
  "editor.padding.bottom": 12,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.parameterHints.enabled": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.inlineSuggest.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": false,
  "vim.startInInsertMode": true,
  "vim.useCtrlKeys": false,
  "vim.overrideCtrlC": false,
  "search.exclude": {
    "**/target": true,
    "**/.gradle": true,
    "**/.terraform": true
  },
  "workbench.colorCustomizations": {
    "[Monokai]": {
      "editor.background": "#222128",
      "editorGutter.background": "#222128",
      "sideBar.background": "#1C1B22",
      "activityBar.background": "#1C1B22",
      "panel.background": "#1C1B22",
      "statusBar.background": "#1C1B22",
      "editorGroupHeader.tabsBackground": "#1C1B22",
      "tab.activeBackground": "#222128",
      "tab.inactiveBackground": "#1C1B22",
      "editorSuggestWidget.background": "#292730",
      "editorSuggestWidget.foreground": "#F3EEF2",
      "editorSuggestWidget.selectedBackground": "#464054",
      "editorSuggestWidget.selectedForeground": "#FFFFFF",
      "editorSuggestWidget.highlightForeground": "#A6E22E",
      "editorGhostText.foreground": "#9A95A4",
      "terminal.background": "#1C1B22",
      "terminal.foreground": "#F3EEF2",
      "terminalCursor.foreground": "#C8AEFA",
      "terminalCursor.background": "#1C1B22",
      "terminal.selectionBackground": "#65557B80",
      "terminal.ansiBlack": "#282631",
      "terminal.ansiRed": "#FF6E82",
      "terminal.ansiGreen": "#A8DD73",
      "terminal.ansiYellow": "#E9CB7F",
      "terminal.ansiBlue": "#82AFFF",
      "terminal.ansiMagenta": "#CA9DF5",
      "terminal.ansiCyan": "#80D7DB",
      "terminal.ansiWhite": "#E0D9E6",
      "terminal.ansiBrightBlack": "#8B8598",
      "terminal.ansiBrightRed": "#FF9AA7",
      "terminal.ansiBrightGreen": "#C7F697",
      "terminal.ansiBrightYellow": "#FFE7A9",
      "terminal.ansiBrightBlue": "#B2CCFF",
      "terminal.ansiBrightMagenta": "#E0C4FF",
      "terminal.ansiBrightCyan": "#ACF0EB",
      "terminal.ansiBrightWhite": "#F8F2FA",
      "diffEditor.insertedLineBackground": "#93C46525",
      "diffEditor.insertedTextBackground": "#93C46554",
      "diffEditor.removedLineBackground": "#F26C8127",
      "diffEditor.removedTextBackground": "#F26C815B",
      "diffEditorOverview.insertedForeground": "#A8DD73",
      "diffEditorOverview.removedForeground": "#FF6E82",
      "editorGutter.addedBackground": "#A8DD73",
      "editorGutter.deletedBackground": "#FF6E82",
      "editorGutter.modifiedBackground": "#82AFFF"
    }
  },
  "chatgpt.openOnStartup": false,
  "workbench.preferredDarkColorTheme": "Monokai",
  "window.autoDetectColorScheme": false,
  "workbench.activityBar.compact": true,
  "zenMode.fullScreen": false,
  "zenMode.centerLayout": false,
  "zenMode.showTabs": "single",
  "zenMode.hideStatusBar": true,
  "zenMode.hideActivityBar": true,
  "zenMode.restore": false,
  "zenMode.hideLineNumbers": false
}
